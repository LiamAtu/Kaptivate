rules_version = '2';

// Every client's files live under clients/{clientId}/...
// Only that client and the owner (admin) can upload or download them.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /clients/{clientId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == clientId || isAdmin());
      // Uploads up to 2 GB (video files are big)
      allow create: if request.auth != null
                    && (request.auth.uid == clientId || isAdmin())
                    && request.resource.size < 2 * 1024 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Everything else is closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
